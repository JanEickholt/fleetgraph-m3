#!/usr/bin/env bash
# FleetGraph pre-commit: fast regression tier on every commit that touches code.
#   enable once per clone:   git config core.hooksPath tools/hooks
#   bypass (emergency only): git commit --no-verify
#
# 1. generators, their inputs and generated files (world/map/locations/regions,
#    docs/contracts.json) are staged as a whole, and the outputs match the source
# 2. this checkout's fleetgraph container runs AND bind-mounts THIS checkout (otherwise
#    the tests would exercise another checkout's code: a false green)
# 3. rebuild if build inputs changed, then ./t --fast (~25 s, no sim)
# Docs-only commits skip everything. Slow tiers (./t -k weekly / demo) stay
# manual: run them after Nav2/sim changes and before each course gate.
set -euo pipefail
root=$(git rev-parse --show-toplevel)
cd "$root"

staged=$(git diff --cached --name-only --diff-filter=ACMRD)
trigger='^(src/|tests/|mock_data/|tools/|t$|compose\.yaml$|Dockerfile$|docs/contracts\.json$)'
code=$(printf '%s\n' "$staged" | grep -E "$trigger" || true)
if [ -z "$code" ]; then
  echo "pre-commit: no code staged, tests skipped"
  exit 0
fi

# The generator checks read the working tree: with only tools/gen_world.py
# staged after regenerating, they would pass and the commit would ship stale
# generated files. So generators, their inputs and outputs go in whole.
generated=(tools/gen_world.py src/fleetgraph_sim/worlds/lab_floor.sdf
           src/fleetgraph_sim/maps/lab_floor.pgm src/fleetgraph_sim/maps/lab_floor.yaml
           src/fleetgraph_sim/config/locations.yaml src/fleetgraph_sim/config/regions.yaml
           tools/export_contracts.py src/fleetgraph_interfaces/msg
           src/fleetgraph_interfaces/srv src/fleetgraph_interfaces/package.xml
           docs/contracts.json)
unstaged=$( (git diff --name-only -- "${generated[@]}"
             git ls-files --others --exclude-standard -- "${generated[@]}") | sort -u)
if [ -n "$unstaged" ]; then
  echo "pre-commit: unstaged changes to generators, their inputs or outputs:" >&2
  printf '%s\n' "$unstaged" | sed 's/^/  /' >&2
  echo "  the generator checks read the working tree: stage (or stash) them" >&2
  exit 1
fi

python3 -I tools/gen_world.py --check
python3 -I tools/export_contracts.py --check

# the compose project of THIS checkout (compose.yaml name, or COMPOSE_PROJECT_NAME
# from .env for a second sim slot) decides which container that is
container=$(docker compose ps -q fleetgraph 2>/dev/null || true)
running=false
[ -n "$container" ] && running=$(docker inspect -f '{{.State.Running}}' "$container" 2>/dev/null || echo false)
if [ "$running" != "true" ]; then
  echo "pre-commit: the fleetgraph container of this checkout is not running." >&2
  echo "  start it from $root:  docker compose up -d   (bypass: git commit --no-verify)" >&2
  exit 1
fi
mounted=$(docker inspect "$container" --format \
  '{{range .Mounts}}{{if eq .Destination "/home/ubuntu/ws/src"}}{{.Source}}{{end}}{{end}}')
if [ "$mounted" != "$root/src" ]; then
  echo "pre-commit: container mounts $mounted," >&2
  echo "  not this checkout ($root/src) — the tests would run the wrong code." >&2
  echo "  re-create it from here:  docker compose up -d" >&2
  exit 1
fi

if ! git diff --quiet -- src tests mock_data tools; then
  echo "pre-commit: WARNING unstaged changes under src/tests/mock_data/tools —" \
       "tests run against the working tree, not exactly what you commit" >&2
fi

build=""
# message/manifest changes need colcon; so do new files (symlink-install only
# links files that existed at the last build)
if printf '%s\n' "$code" | grep -qE '^src/.*(\.msg|\.srv|CMakeLists\.txt|package\.xml|setup\.(py|cfg))$' ||
   git diff --cached --name-only --diff-filter=A | grep -q '^src/'; then
  build="--build"
fi

echo "pre-commit: ./t $build --fast"
./t $build --fast
