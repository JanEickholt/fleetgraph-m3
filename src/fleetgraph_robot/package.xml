<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fleetgraph_robot</name>
  <version>0.1.0</version>
  <description>FleetGraph M3 robot agent: task state machine, Nav2 execution, telemetry; mock orchestrator for independent testing.</description>
  <maintainer email="jan.eickholt@stud.uni-due.de">Jan Eickholt</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>fleetgraph_interfaces</exec_depend>
  <exec_depend>fleetgraph_sim</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
